{
  "name": "@artifact-validation/runtime-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "artifact-validation-runtime": "./dist/cli.js",
    "artifact-validation-runtime-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run --config ../../vitest.config.ts --dir . test"
  },
  "dependencies": {
    "@artifact-validation/adapters": "workspace:*",
    "@artifact-validation/contracts": "workspace:*",
    "@artifact-validation/file-store": "workspace:*",
    "@artifact-validation/llm-integration": "workspace:*",
    "@artifact-validation/runtime-core": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  }
}
