{
  "name": "@embed-agent/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http-client.js": {
      "types": "./dist/http-client.d.ts",
      "import": "./dist/http-client.js"
    },
    "./server-start.js": {
      "types": "./dist/server-start.d.ts",
      "import": "./dist/server-start.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --config ../../vitest.config.ts --dir . test"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@embed-agent/runtime": "workspace:*",
    "@embed-agent/stores": "workspace:*",
    "@embed-agent/views": "workspace:*",
    "@embed-agent/agent": "workspace:*",
    "@embed-agent/contracts": "workspace:*",
    "@embed-agent/notify": "workspace:*",
    "@embed-agent/tools": "workspace:*"
  },
  "bin": {
    "embedagent": "./dist/main.js"
  }
}
