{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embed Agent",
  "version": "0.1.5",
  "identifier": "com.embedagent.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "pnpm --dir ../../apps/webui build",
    "beforeBuildCommand": "pnpm --dir ../../apps/webui build"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Embed Agent",
        "width": 1440,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "../desktop-runtime/bin/embed-agent-node"
    ],
    "resources": {
      "../desktop-runtime/server": "desktop-runtime/server",
      "../desktop-runtime/mcp": "desktop-runtime/mcp",
      "../desktop-runtime/webui": "desktop-runtime/webui",
      "../desktop-runtime/config": "desktop-runtime/config",
      "../desktop-runtime/integrations": "desktop-runtime/integrations",
      "../desktop-runtime/lib": "desktop-runtime/lib"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  }
}
