{
  "name": "artifact-validation-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime-first artifact validation agent for real-device verification.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <26.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
